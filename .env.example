# Copy to .env.local and fill in. Only VITE_* vars are exposed to the browser.
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=

# Chatbot backend. Leave empty to use the built-in FAQ answers.
# When set, the chat POSTs { lang, messages: [{ role, content }] } here and expects { reply: string }.
# Never put an AI provider API key in a VITE_* variable; keep it in the backend.
VITE_CHAT_API_URL=
